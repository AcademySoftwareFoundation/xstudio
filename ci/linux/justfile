# Containerised compile checks for xSTUDIO.
#
#   just -f ci/linux/justfile -d ci/linux <recipe>
#   # or from this directory:
#   just ubuntu24-deps
#   just ubuntu24-compile
#   just rocky9-compile
#   just compile
#
# Defaults: STUDIO_PLUGINS=  BMD_DECKLINK=OFF
# Default JOBS=8. Override: just BMD_DECKLINK=ON JOBS=4 ubuntu24-compile
#
# Version pins: versions.env only (sourced here, forwarded as --build-arg).
#
# CI overrides:
#   DEPS_IMAGE=ghcr.io/org/repo/xstudio-deps:ubuntu2404  # tag / FROM image
#   PUSH_DEPS=1                                          # push deps after build

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

linux_dir := justfile_directory()
repo_root := absolute_path(linux_dir / ".." / "..")

engine := `command -v docker 2>/dev/null || command -v podman 2>/dev/null || true`
image_prefix := if `basename "$(command -v docker 2>/dev/null || command -v podman 2>/dev/null || echo docker)"` == "podman" { "localhost/" } else { "" }

# Overridable from the environment or `just VAR=value recipe`
export JOBS := env("JOBS", "8")
export BMD_DECKLINK := env("BMD_DECKLINK", "OFF")
export STUDIO_PLUGINS := env("STUDIO_PLUGINS", "")
export NOCACHE := env("NOCACHE", "0")
export PUSH_DEPS := env("PUSH_DEPS", "0")
export DEPS_IMAGE := env("DEPS_IMAGE", "")

nocache_flag := if NOCACHE == "1" { "--no-cache" } else { "" }

# Show available recipes
default:
    @just --list

# Build dependency images + compile xSTUDIO on both distros
compile: ubuntu24-compile rocky9-compile

# Build Ubuntu 24.04 dependency image
ubuntu24-deps: (_deps "ubuntu24")

# Build Rocky 9 dependency image
rocky9-deps: (_deps "rocky9")

# Compile-check xSTUDIO on Ubuntu 24.04
ubuntu24-compile: (_compile "ubuntu24")

# Compile-check xSTUDIO on Rocky 9
rocky9-compile: (_compile "rocky9")

# Interactive shell in the Ubuntu deps image
ubuntu24-shell: ubuntu24-deps
    #!/usr/bin/env bash
    set -euo pipefail
    local_tag="{{ image_prefix }}xstudio-deps:ubuntu2404"
    img="{{ DEPS_IMAGE }}"
    [ -n "$img" ] || img="$local_tag"
    {{ engine }} run --rm -it "$img" /bin/bash

# Interactive shell in the Rocky deps image
rocky9-shell: rocky9-deps
    #!/usr/bin/env bash
    set -euo pipefail
    local_tag="{{ image_prefix }}xstudio-deps:rocky9"
    img="{{ DEPS_IMAGE }}"
    [ -n "$img" ] || img="$local_tag"
    {{ engine }} run --rm -it "$img" /bin/bash

# ---------------------------------------------------------------------------
# Private helpers
# ---------------------------------------------------------------------------

[private]
_require-engine:
    #!/usr/bin/env bash
    if [ -z "{{ engine }}" ]; then
      echo "ERROR: neither docker nor podman found in PATH" >&2
      exit 1
    fi

[private]
_deps distro: _require-engine
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{ linux_dir }}/versions.env"
    export DOCKER_BUILDKIT=1

    case "{{ distro }}" in
      ubuntu24)
        df="{{ linux_dir }}/dockerfiles/ubuntu2404.deps.Dockerfile"
        local_tag="{{ image_prefix }}xstudio-deps:ubuntu2404"
        lock_name="ubuntu24"
        ;;
      rocky9)
        df="{{ linux_dir }}/dockerfiles/rocky9.deps.Dockerfile"
        local_tag="{{ image_prefix }}xstudio-deps:rocky9"
        lock_name="rocky9"
        ;;
      *)
        echo "ERROR: unknown distro '{{ distro }}'" >&2
        exit 1
        ;;
    esac

    # Prevent overlapping deps builds for the same distro.
    lock_dir="${XDG_RUNTIME_DIR:-/tmp}/xstudio-deps"
    mkdir -p "$lock_dir"
    deps_lock="$lock_dir/${lock_name}.lock"
    exec 8>"$deps_lock"
    if ! flock -n 8; then
      echo "ERROR: deps build already in progress for ${lock_name}" >&2
      exit 1
    fi
    trap 'rm -f "$deps_lock"' EXIT

    if [ -n "{{ DEPS_IMAGE }}" ]; then
      publish_tag="{{ DEPS_IMAGE }}"
    else
      publish_tag="$local_tag"
    fi

    # Reuse layers from GHCR when available (needs buildx driver: docker in CI).
    {{ engine }} pull "$publish_tag" 2>/dev/null || true

    BUILDKIT_INLINE_CACHE=1 {{ engine }} build \
      -f "$df" \
      {{ nocache_flag }} \
      --cache-from "$publish_tag" \
      --build-arg BUILDKIT_INLINE_CACHE=1 \
      --build-arg JOBS="{{ JOBS }}" \
      --build-arg CMAKE_VERSION="$CMAKE_VERSION" \
      --build-arg NINJA_VERSION="$NINJA_VERSION" \
      --build-arg PYBIND11_VERSION="$PYBIND11_VERSION" \
      --build-arg AQTINSTALL_VERSION="$AQTINSTALL_VERSION" \
      --build-arg QT_VERSION="$QT_VERSION" \
      --build-arg OPENEXR_REF="$OPENEXR_REF" \
      --build-arg CAF_VERSION="$CAF_VERSION" \
      --build-arg OCIO_VERSION="$OCIO_VERSION" \
      --build-arg OTIO_REF="$OTIO_REF" \
      --build-arg FILESEQ_CPP_REF="$FILESEQ_CPP_REF" \
      --build-arg FFMPEG_VERSION="$FFMPEG_VERSION" \
      --build-arg OIIO_VERSION="$OIIO_VERSION" \
      --build-arg LIBRAW_VERSION="$LIBRAW_VERSION" \
      --build-arg LIBDE265_VERSION="$LIBDE265_VERSION" \
      --build-arg LIBHEIF_VERSION="$LIBHEIF_VERSION" \
      --build-arg EXIV2_VERSION="$EXIV2_VERSION" \
      --build-arg GLEW_VERSION="$GLEW_VERSION" \
      --build-arg JSON_VERSION="$JSON_VERSION" \
      --build-arg SPDLOG_VERSION="$SPDLOG_VERSION" \
      --build-arg FMT_VERSION="$FMT_VERSION" \
      --build-arg LIBJPEGTURBO_VERSION="$LIBJPEGTURBO_VERSION" \
      --build-arg X264_REF="$X264_REF" \
      --build-arg X265_VERSION="$X265_VERSION" \
      --build-arg FDKAAC_REF="$FDKAAC_REF" \
      --build-arg NASM_VERSION="$NASM_VERSION" \
      -t "$publish_tag" \
      "{{ linux_dir }}"

    # Keep a local short tag as well when publishing under a registry name.
    if [ "$publish_tag" != "$local_tag" ]; then
      {{ engine }} tag "$publish_tag" "$local_tag"
    fi

    if [ "{{ PUSH_DEPS }}" = "1" ]; then
      echo "==> Pushing $publish_tag"
      {{ engine }} push "$publish_tag"
    fi

[private]
_compile distro: (_deps distro)
    #!/usr/bin/env bash
    set -euo pipefail
    export DOCKER_BUILDKIT=1

    case "{{ distro }}" in
      ubuntu24)
        df="{{ linux_dir }}/dockerfiles/ubuntu2404.build.Dockerfile"
        local_tag="{{ image_prefix }}xstudio-deps:ubuntu2404"
        label="Ubuntu 24.04"
        ;;
      rocky9)
        df="{{ linux_dir }}/dockerfiles/rocky9.build.Dockerfile"
        local_tag="{{ image_prefix }}xstudio-deps:rocky9"
        label="Rocky 9"
        ;;
      *)
        echo "ERROR: unknown distro '{{ distro }}'" >&2
        exit 1
        ;;
    esac

    if [ -n "{{ DEPS_IMAGE }}" ]; then
      deps_img="{{ DEPS_IMAGE }}"
    else
      deps_img="$local_tag"
    fi

    {{ engine }} build \
      -f "$df" \
      --target compile {{ nocache_flag }} \
      --build-arg JOBS="{{ JOBS }}" \
      --build-arg BMD_DECKLINK="{{ BMD_DECKLINK }}" \
      --build-arg STUDIO_PLUGINS="{{ STUDIO_PLUGINS }}" \
      --build-arg DEPS_IMAGE="$deps_img" \
      "{{ repo_root }}"
    echo "==> ${label} compile OK"
