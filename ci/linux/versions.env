# Pinned toolchain / Qt versions for Linux Docker images and local devenv.
# Third-party libs come from vcpkg.json (+ NuGet binary cache), not this file.

# Build tooling (pip — distro packages are often too old)
CMAKE_VERSION=3.31.10
NINJA_VERSION=1.11.1.1
AQTINSTALL_VERSION=3.1.18

# Qt SDK (aqtinstall, no Qt account needed)
QT_VERSION=6.5.3
