# Pinned dependency versions for the containerised compile builds.
# Single source of truth — sourced by just and forwarded as Docker --build-arg.
# Shell-sourceable only (KEY=VALUE, no spaces/quotes).

# Build tooling (pip — distro packages are too old)
CMAKE_VERSION=3.31.10
NINJA_VERSION=1.11.1.1
PYBIND11_VERSION=2.13.6
AQTINSTALL_VERSION=3.1.18

# Qt SDK (aqtinstall, no Qt account needed)
QT_VERSION=6.5.3

# Source-built dependencies (identical on every distro)
OPENEXR_REF=v3.1.13
CAF_VERSION=1.0.2
OCIO_VERSION=2.2.1
OTIO_REF=v0.17.0
FILESEQ_CPP_REF=v3.2.0
FFMPEG_VERSION=7.1.4
OIIO_VERSION=3.0.9.1
LIBRAW_VERSION=0.22.1
LIBDE265_VERSION=1.0.19
LIBHEIF_VERSION=1.17.6
EXIV2_VERSION=0.28.9

# Source-built only where the distro lacks a suitable package (Rocky 9)
GLEW_VERSION=2.3.1
JSON_VERSION=3.12.0
SPDLOG_VERSION=1.9.2
FMT_VERSION=8.0.1
LIBJPEGTURBO_VERSION=3.1.4.1

# FFmpeg codecs (source on Rocky, apt on Ubuntu)
X264_REF=stable
X265_VERSION=3.5
FDKAAC_REF=master
NASM_VERSION=2.16.03
